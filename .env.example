# CONFIGURACIÓN DE NÚCLEO
AGENT_NAME=VALENTINA_OMEGA
VERSION=9.0.0_SINTERGIAL
ENVIRONMENT=PRODUCTION

# CEREBRO 1: COCKROACHDB (MEMORIA AGÉNTICA)
COCKROACH_URL=postgresql://root@localhost:26257/valentina_memory?sslmode=disable

# CEREBRO 2: GOOGLE GEMINI (RAZONAMIENTO)
GOOGLE_API_KEY=tu_api_key_aqui

# CEREBRO 6: AWS (INFRAESTRUCTURA)
AWS_REGION=us-east-1
