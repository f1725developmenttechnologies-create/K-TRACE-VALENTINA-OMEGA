AWS_SECRET_ACCESS_KEY=tu_secret_key
S3_BUCKET_EVIDENCE=k-trace-evidence-vault

# CEREBRO 4: SEGURIDAD (HASH SINTERGIAL)
SECRET_ENCRYPTION_KEY=genera_una_key_fernet_aqui
